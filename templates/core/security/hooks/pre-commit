#!/bin/sh
# Kiritek managed pre-commit hook (dispatcher).
# Encadena un hook previo si existe y luego ejecuta el gate de Kiritek.
# Guard anti-recursión y preservación de exit code.

if [ -n "$KIRITEK_HOOK_RUNNING" ]; then
  exit 0
fi
export KIRITEK_HOOK_RUNNING=1

# Resolver raíz del repo sin asumir cwd.
REPO_ROOT=$(git rev-parse --show-toplevel 2>/dev/null) || exit 0

# Encadenar hook previo preservado por Kiritek, si existe.
PREV="$REPO_ROOT/.kiritek/hooks/pre-commit.previous"
if [ -x "$PREV" ]; then
  "$PREV" "$@" || exit $?
fi

# Gate de Kiritek: escaneo del contenido staged. El JSON completo va a
# .kiritek/tmp/ (ignorado por Git); en la terminal sólo queda el resumen.
if command -v kiritek-init >/dev/null 2>&1; then
  mkdir -p "$REPO_ROOT/.kiritek/tmp"
  kiritek-init scan --scope=staged --format=json > "$REPO_ROOT/.kiritek/tmp/pre-commit.json" || exit $?
else
  echo "kiritek ⚠ kiritek-init no está en el PATH: controles de seguridad OMITIDOS en este commit." >&2
fi

exit 0
