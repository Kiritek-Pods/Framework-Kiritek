{
  "_comment": "Kiritek managed Claude Code PreToolUse hooks. Se fusiona dentro de .claude/settings.json sin sobrescribir hooks preexistentes del usuario. El shim decide allow/ask/deny; exit 2 bloquea como fail-safe.",
  "hooks": {
    "PreToolUse": [
      {
        "matcher": "Edit|Write|MultiEdit|NotebookEdit",
        "hooks": [
          {
            "type": "command",
            "command": "\"$CLAUDE_PROJECT_DIR/.kiritek/adapters/claude/pretooluse.sh\""
          }
        ]
      },
      {
        "matcher": "Bash",
        "hooks": [
          {
            "type": "command",
            "command": "\"$CLAUDE_PROJECT_DIR/.kiritek/adapters/claude/pretooluse.sh\""
          }
        ]
      },
      {
        "matcher": "mcp__.*",
        "hooks": [
          {
            "type": "command",
            "command": "\"$CLAUDE_PROJECT_DIR/.kiritek/adapters/claude/pretooluse.sh\""
          }
        ]
      }
    ]
  }
}
