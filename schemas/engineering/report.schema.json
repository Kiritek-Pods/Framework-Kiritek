{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "$id": "https://kiritek.dev/schemas/engineering/report.schema.json",
  "title": "Kiritek Engineering — reporte de ejecución persistible",
  "description": "Forma publicable del reporte: la minimización conserva sólo estas propiedades. Sin código, queries, payloads, prompts, PII ni rutas absolutas.",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schemaVersion",
    "domain",
    "packId",
    "moment",
    "catalog",
    "configHash",
    "revision",
    "results",
    "summary",
    "outcome",
    "events",
    "diagnostics"
  ],
  "properties": {
    "schemaVersion": {
      "type": "integer",
      "const": 1
    },
    "domain": {
      "type": "string",
      "const": "engineering"
    },
    "packId": {
      "type": "string",
      "const": "engineering/guardrails"
    },
    "moment": {
      "$ref": "engineering/common.schema.json#/definitions/moment"
    },
    "catalog": {
      "$ref": "engineering/common.schema.json#/definitions/catalogRef"
    },
    "configHash": {
      "$ref": "engineering/common.schema.json#/definitions/sha256"
    },
    "revision": {
      "$ref": "engineering/common.schema.json#/definitions/revision"
    },
    "results": {
      "type": "array",
      "items": {
        "$ref": "engineering/result-envelope.schema.json"
      }
    },
    "summary": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "total",
        "byState",
        "byDecision"
      ],
      "properties": {
        "total": {
          "type": "integer",
          "minimum": 0
        },
        "byState": {
          "type": "object",
          "additionalProperties": {
            "type": "integer",
            "minimum": 0
          }
        },
        "byDecision": {
          "type": "object",
          "additionalProperties": {
            "type": "integer",
            "minimum": 0
          }
        }
      }
    },
    "outcome": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "decision",
        "policyDeny",
        "operationalError",
        "blockingResults",
        "exitCodeHint"
      ],
      "properties": {
        "decision": {
          "type": "string",
          "enum": [
            "allow",
            "warn",
            "deny",
            "error"
          ]
        },
        "policyDeny": {
          "type": "boolean"
        },
        "operationalError": {
          "type": "boolean"
        },
        "blockingResults": {
          "type": "array",
          "items": {
            "type": "object",
            "additionalProperties": false,
            "required": [
              "unitId",
              "controlId"
            ],
            "properties": {
              "unitId": {
                "$ref": "engineering/common.schema.json#/definitions/namespacedId"
              },
              "controlId": {
                "$ref": "engineering/common.schema.json#/definitions/controlId"
              }
            }
          }
        },
        "exitCodeHint": {
          "type": "integer",
          "enum": [
            0,
            1,
            3
          ]
        }
      }
    },
    "exceptions": {
      "description": "Deuda visible de waivers/N-A (R18.5, T13.4). Sólo ids, códigos y fechas: nunca razón, owner, aprobador ni ticket.",
      "type": "object",
      "additionalProperties": false,
      "required": [
        "applied",
        "reactivated",
        "rejected",
        "debt",
        "nextExpiry"
      ],
      "properties": {
        "applied": {
          "type": "array",
          "items": {
            "type": "object",
            "additionalProperties": false,
            "required": [
              "kind",
              "ref",
              "unitId",
              "controlId",
              "expiresAt",
              "findings"
            ],
            "properties": {
              "kind": {
                "type": "string",
                "enum": [
                  "waiver",
                  "governed-na"
                ]
              },
              "ref": {
                "$ref": "engineering/common.schema.json#/definitions/ref"
              },
              "unitId": {
                "$ref": "engineering/common.schema.json#/definitions/namespacedId"
              },
              "controlId": {
                "$ref": "engineering/common.schema.json#/definitions/controlId"
              },
              "expiresAt": {
                "$ref": "engineering/common.schema.json#/definitions/isoTimestamp"
              },
              "findings": {
                "type": "integer",
                "minimum": 0
              }
            }
          }
        },
        "reactivated": {
          "type": "array",
          "items": {
            "type": "object",
            "additionalProperties": false,
            "required": [
              "kind",
              "ref",
              "unitId",
              "controlId",
              "code"
            ],
            "properties": {
              "kind": {
                "type": "string",
                "enum": [
                  "waiver",
                  "governed-na"
                ]
              },
              "ref": {
                "$ref": "engineering/common.schema.json#/definitions/ref"
              },
              "unitId": {
                "$ref": "engineering/common.schema.json#/definitions/namespacedId"
              },
              "controlId": {
                "$ref": "engineering/common.schema.json#/definitions/controlId"
              },
              "code": {
                "type": "string",
                "pattern": "^[A-Z][A-Z0-9_]*$"
              }
            }
          }
        },
        "rejected": {
          "type": "array",
          "items": {
            "type": "object",
            "additionalProperties": false,
            "required": [
              "file",
              "kind",
              "errors"
            ],
            "properties": {
              "file": {
                "$ref": "engineering/common.schema.json#/definitions/repoPath"
              },
              "kind": {
                "type": "string",
                "enum": [
                  "waiver",
                  "governed-na"
                ]
              },
              "ref": {
                "$ref": "engineering/common.schema.json#/definitions/ref"
              },
              "errors": {
                "type": "array",
                "minItems": 1,
                "items": {
                  "type": "string",
                  "pattern": "^[A-Z][A-Z0-9_]*$"
                }
              },
              "unitId": {
                "$ref": "engineering/common.schema.json#/definitions/namespacedId"
              },
              "controlId": {
                "$ref": "engineering/common.schema.json#/definitions/controlId"
              }
            }
          }
        },
        "debt": {
          "type": "object",
          "additionalProperties": false,
          "required": [
            "waivers",
            "suppressedFindings",
            "notApplicable"
          ],
          "properties": {
            "waivers": {
              "type": "integer",
              "minimum": 0
            },
            "suppressedFindings": {
              "type": "integer",
              "minimum": 0
            },
            "notApplicable": {
              "type": "integer",
              "minimum": 0
            }
          }
        },
        "nextExpiry": {
          "anyOf": [
            {
              "type": "null"
            },
            {
              "$ref": "engineering/common.schema.json#/definitions/isoTimestamp"
            }
          ]
        }
      }
    },
    "events": {
      "type": "array",
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "type",
          "unitId",
          "controlId"
        ],
        "properties": {
          "type": {
            "type": "string",
            "enum": [
              "deny-not-eligible",
              "exception-applied",
              "exception-reactivated"
            ]
          },
          "unitId": {
            "$ref": "engineering/common.schema.json#/definitions/namespacedId"
          },
          "controlId": {
            "$ref": "engineering/common.schema.json#/definitions/controlId"
          },
          "degradedTo": {
            "type": "string",
            "enum": [
              "warn",
              "error"
            ]
          },
          "violations": {
            "type": "array",
            "items": {
              "type": "string",
              "minLength": 1
            }
          },
          "kind": {
            "type": "string",
            "enum": [
              "waiver",
              "governed-na"
            ]
          },
          "ref": {
            "$ref": "engineering/common.schema.json#/definitions/ref"
          },
          "expiresAt": {
            "$ref": "engineering/common.schema.json#/definitions/isoTimestamp"
          },
          "code": {
            "type": "string",
            "pattern": "^[A-Z][A-Z0-9_]*$"
          }
        }
      }
    },
    "diagnostics": {
      "type": "array",
      "items": {
        "$ref": "engineering/common.schema.json#/definitions/diagnostic"
      }
    }
  }
}
