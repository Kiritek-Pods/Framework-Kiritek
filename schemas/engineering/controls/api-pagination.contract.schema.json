{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "$id": "https://kiritek.dev/schemas/engineering/controls/api-pagination.contract.schema.json",
  "title": "Contrato de paginación de API (api.pagination)",
  "description": "Endpoints de listado con tamaño por defecto y máximo, modo (cursor u offset) y nombres de parámetros y campos.",
  "type": "object",
  "additionalProperties": false,
  "required": ["schemaVersion", "control", "collections"],
  "properties": {
    "$schema": { "type": "string" },
    "schemaVersion": { "type": "integer", "const": 1 },
    "control": { "type": "string", "const": "api.pagination" },
    "collections": {
      "type": "array",
      "minItems": 1,
      "maxItems": 50,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["id", "path", "mode", "defaultPageSize", "maxPageSize"],
        "properties": {
          "id": { "type": "string", "pattern": "^[a-z][a-z0-9-]*$", "maxLength": 64 },
          "path": { "type": "string", "pattern": "^/[A-Za-z0-9/_.:-]*$", "maxLength": 200 },
          "mode": { "type": "string", "enum": ["cursor", "offset"] },
          "defaultPageSize": { "type": "integer", "minimum": 1, "maximum": 1000 },
          "maxPageSize": { "type": "integer", "minimum": 1, "maximum": 1000 },
          "itemsField": { "type": "string", "pattern": "^[a-zA-Z][a-zA-Z0-9_]*$" },
          "cursorField": { "type": "string", "pattern": "^[a-zA-Z][a-zA-Z0-9_]*$" },
          "limitParam": { "type": "string", "pattern": "^[a-zA-Z][a-zA-Z0-9_]*$" },
          "cursorParam": { "type": "string", "pattern": "^[a-zA-Z][a-zA-Z0-9_]*$" },
          "offsetParam": { "type": "string", "pattern": "^[a-zA-Z][a-zA-Z0-9_]*$" }
        }
      }
    },
    "harness": { "$ref": "engineering/controls/harness.schema.json#/definitions/harness" }
  }
}
