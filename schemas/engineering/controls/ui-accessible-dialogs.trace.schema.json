{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "$id": "https://kiritek.dev/schemas/engineering/controls/ui-accessible-dialogs.trace.schema.json",
  "title": "Traza conductual de ui.accessible-dialogs",
  "description": "Sólo booleanos derivados del foco, rol y estado. Nunca textos.",
  "type": "object",
  "additionalProperties": false,
  "required": ["schemaVersion", "harness", "scenarios"],
  "properties": {
    "schemaVersion": { "type": "integer", "const": 1 },
    "harness": { "$ref": "engineering/controls/harness.schema.json#/definitions/harnessInfo" },
    "fatal": { "type": "string", "pattern": "^[A-Z_]+$" },
    "scenarios": { "type": "array", "maxItems": 40, "items": { "$ref": "#/definitions/scenario" } }
  },
  "definitions": {
    "scenario": {
      "type": "object",
      "additionalProperties": false,
      "required": ["id", "status", "steps"],
      "properties": {
        "id": { "$ref": "engineering/controls/harness.schema.json#/definitions/scenarioId" },
        "status": { "$ref": "engineering/controls/harness.schema.json#/definitions/scenarioStatus" },
        "limitation": { "$ref": "engineering/controls/harness.schema.json#/definitions/limitation" },
        "steps": { "type": "array", "maxItems": 1, "items": { "$ref": "#/definitions/step" } }
      }
    },
    "step": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "opened": { "type": "boolean" },
        "focusIn": { "type": "boolean" },
        "trapped": { "type": "boolean" },
        "closed": { "type": "boolean" },
        "focusReturned": { "type": "boolean" },
        "roleOk": { "type": "boolean" },
        "labelled": { "type": "boolean" },
        "inert": { "type": "boolean" }
      }
    }
  }
}
