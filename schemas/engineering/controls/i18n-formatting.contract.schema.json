{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "$id": "https://kiritek.dev/schemas/engineering/controls/i18n-formatting.contract.schema.json",
  "title": "Contrato de localización (i18n.formatting)",
  "description": "Idiomas soportados, idioma por defecto, moneda y qué formatos se verifican.",
  "type": "object",
  "additionalProperties": false,
  "required": ["schemaVersion", "control", "locales", "defaultLocale", "currency", "formats"],
  "properties": {
    "$schema": { "type": "string" },
    "schemaVersion": { "type": "integer", "const": 1 },
    "control": { "type": "string", "const": "i18n.formatting" },
    "locales": { "type": "array", "minItems": 1, "maxItems": 50, "uniqueItems": true, "items": { "type": "string", "pattern": "^[a-z]{2,3}(-[A-Z]{2})?$" } },
    "defaultLocale": { "type": "string", "pattern": "^[a-z]{2,3}(-[A-Z]{2})?$" },
    "currency": { "type": "string", "pattern": "^[A-Z]{3}$" },
    "formats": { "type": "array", "minItems": 1, "uniqueItems": true, "items": { "type": "string", "enum": ["date", "number", "currency", "timezone", "messages"] } },
    "harness": { "$ref": "engineering/controls/harness.schema.json#/definitions/harness" }
  }
}
