{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "$id": "https://kiritek.dev/schemas/engineering/controls/flags-lifecycle.trace.schema.json",
  "title": "Traza conductual de flags.lifecycle",
  "description": "Sólo la clase del valor resuelto (default, del proveedor, actualizado…). Nunca contextos de usuario ni valores del proveedor.",
  "type": "object",
  "additionalProperties": false,
  "required": ["schemaVersion", "harness", "scenarios"],
  "properties": {
    "schemaVersion": { "type": "integer", "const": 1 },
    "harness": { "$ref": "engineering/controls/harness.schema.json#/definitions/harnessInfo" },
    "fatal": { "type": "string", "pattern": "^[A-Z_]+$" },
    "scenarios": { "type": "array", "maxItems": 20, "items": { "$ref": "#/definitions/scenario" } }
  },
  "definitions": {
    "scenario": {
      "type": "object",
      "additionalProperties": false,
      "required": ["id", "status", "steps"],
      "properties": {
        "id": { "$ref": "engineering/controls/harness.schema.json#/definitions/scenarioId" },
        "status": { "$ref": "engineering/controls/harness.schema.json#/definitions/scenarioStatus" },
        "limitation": { "$ref": "engineering/controls/harness.schema.json#/definitions/limitation" },
        "steps": { "type": "array", "maxItems": 2, "items": { "$ref": "#/definitions/step" } }
      }
    },
    "step": {
      "type": "object",
      "additionalProperties": false,
      "required": ["result"],
      "properties": {
        "result": { "type": "string", "enum": ["default", "provider", "updated", "falsy", "other", "error", "hang"] }
      }
    }
  }
}
