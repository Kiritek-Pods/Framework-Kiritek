{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "$id": "https://kiritek.dev/schemas/engineering/controls/api-idempotency.contract.schema.json",
  "title": "Contrato de idempotencia (api.idempotency)",
  "description": "Endpoints que modifican datos y aceptan clave de idempotencia. sampleBody es un cuerpo sintético de prueba (nunca datos reales).",
  "type": "object",
  "additionalProperties": false,
  "required": ["schemaVersion", "control", "endpoints"],
  "properties": {
    "$schema": { "type": "string" },
    "schemaVersion": { "type": "integer", "const": 1 },
    "control": { "type": "string", "const": "api.idempotency" },
    "endpoints": {
      "type": "array",
      "minItems": 1,
      "maxItems": 50,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["id", "method", "path", "keyHeader", "requireKey", "sampleBody"],
        "properties": {
          "id": { "type": "string", "pattern": "^[a-z][a-z0-9-]*$", "maxLength": 64 },
          "method": { "type": "string", "enum": ["POST", "PUT", "PATCH", "DELETE"] },
          "path": { "type": "string", "pattern": "^/[A-Za-z0-9/_.:-]*$", "maxLength": 200 },
          "keyHeader": { "type": "string", "pattern": "^[A-Za-z][A-Za-z0-9-]*$", "maxLength": 64 },
          "requireKey": { "type": "boolean" },
          "sampleBody": { "type": "object", "maxProperties": 30 }
        }
      }
    },
    "harness": { "$ref": "engineering/controls/harness.schema.json#/definitions/harness" }
  }
}
