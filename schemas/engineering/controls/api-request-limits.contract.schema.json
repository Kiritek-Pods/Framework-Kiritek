{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "$id": "https://kiritek.dev/schemas/engineering/controls/api-request-limits.contract.schema.json",
  "title": "Contrato de límites de request (api.request-limits)",
  "description": "Tamaño máximo del cuerpo, timeout por request y endpoints a ejercitar con cuerpos sintéticos.",
  "type": "object",
  "additionalProperties": false,
  "required": ["schemaVersion", "control", "maxBodyBytes", "timeoutMs", "endpoints"],
  "properties": {
    "$schema": { "type": "string" },
    "schemaVersion": { "type": "integer", "const": 1 },
    "control": { "type": "string", "const": "api.request-limits" },
    "maxBodyBytes": { "type": "integer", "minimum": 256, "maximum": 10485760 },
    "timeoutMs": { "type": "integer", "minimum": 10, "maximum": 120000 },
    "endpoints": {
      "type": "array",
      "minItems": 1,
      "maxItems": 20,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["id", "method", "path"],
        "properties": {
          "id": { "type": "string", "pattern": "^[a-z][a-z0-9-]*$", "maxLength": 64 },
          "method": { "type": "string", "enum": ["GET", "POST", "PUT", "PATCH", "DELETE"] },
          "path": { "type": "string", "pattern": "^/[A-Za-z0-9/_.:-]*$", "maxLength": 200 },
          "sampleBody": { "type": "object", "maxProperties": 30 }
        }
      }
    },
    "harness": { "$ref": "engineering/controls/harness.schema.json#/definitions/harness" }
  }
}
