{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "$id": "https://kiritek.dev/schemas/engineering/controls/ui-destructive-actions.trace.schema.json",
  "title": "Traza conductual de ui.destructive-actions",
  "description": "Sólo conteos, estado y la clase del mensaje. Nunca los datos afectados.",
  "type": "object",
  "additionalProperties": false,
  "required": ["schemaVersion", "harness", "scenarios"],
  "properties": {
    "schemaVersion": { "type": "integer", "const": 1 },
    "harness": { "$ref": "engineering/controls/harness.schema.json#/definitions/harnessInfo" },
    "fatal": { "type": "string", "pattern": "^[A-Z_]+$" },
    "scenarios": { "type": "array", "maxItems": 50, "items": { "$ref": "#/definitions/scenario" } }
  },
  "definitions": {
    "scenario": {
      "type": "object",
      "additionalProperties": false,
      "required": ["id", "status", "steps"],
      "properties": {
        "id": { "$ref": "engineering/controls/harness.schema.json#/definitions/scenarioId" },
        "status": { "$ref": "engineering/controls/harness.schema.json#/definitions/scenarioStatus" },
        "limitation": { "$ref": "engineering/controls/harness.schema.json#/definitions/limitation" },
        "steps": { "type": "array", "maxItems": 1, "items": { "$ref": "#/definitions/step" } }
      }
    },
    "step": {
      "type": "object",
      "additionalProperties": false,
      "required": ["executions"],
      "properties": {
        "executions": { "type": "integer", "minimum": 0, "maximum": 100 },
        "effective": { "type": "integer", "minimum": -100, "maximum": 100 },
        "dialog": { "type": "boolean" },
        "state": { "type": "string", "enum": ["idle", "pending", "done", "undone", "cancelled", "error", "other"] },
        "message": { "type": "string", "enum": ["ok", "empty", "internal-key", "markup"] }
      }
    }
  }
}
