{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "$id": "https://kiritek.dev/schemas/engineering/controls/api-response-schema.contract.schema.json",
  "title": "Contrato de schemas de respuesta (api.response-schema)",
  "description": "Endpoints con el JSON Schema de su respuesta de éxito (y opcionalmente un cuerpo inválido y el schema común de errores). Los schemas usan el subconjunto verificable: type, properties, required, items, enum, const, anyOf, límites y $ref locales.",
  "type": "object",
  "additionalProperties": false,
  "required": ["schemaVersion", "control", "endpoints"],
  "properties": {
    "$schema": { "type": "string" },
    "schemaVersion": { "type": "integer", "const": 1 },
    "control": { "type": "string", "const": "api.response-schema" },
    "errorSchema": { "type": "object", "maxProperties": 20 },
    "endpoints": {
      "type": "array",
      "minItems": 1,
      "maxItems": 50,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["id", "method", "path", "responseSchema"],
        "properties": {
          "id": { "type": "string", "pattern": "^[a-z][a-z0-9-]*$", "maxLength": 64 },
          "method": { "type": "string", "enum": ["GET", "POST", "PUT", "PATCH", "DELETE"] },
          "path": { "type": "string", "pattern": "^/[A-Za-z0-9/_.:-]*$", "maxLength": 200 },
          "status": { "type": "integer", "minimum": 200, "maximum": 299 },
          "sampleBody": { "type": "object", "maxProperties": 30 },
          "invalidBody": { "type": "object", "maxProperties": 30 },
          "responseSchema": { "type": "object", "maxProperties": 20 }
        }
      }
    },
    "harness": { "$ref": "engineering/controls/harness.schema.json#/definitions/harness" }
  }
}
