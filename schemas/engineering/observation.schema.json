{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "$id": "https://kiritek.dev/schemas/engineering/observation.schema.json",
  "title": "Kiritek Engineering Observation",
  "description": "Salida normalizada de un collector. No admite campos de decisión.",
  "type": "object",
  "additionalProperties": false,
  "required": ["schemaVersion", "observationId", "kind", "controlId", "unitId", "source", "revision", "scopeHash", "configHash", "catalogDigest", "observedAt", "status", "confidence", "evidenceClass", "facts", "limitations", "durationMs", "cache"],
  "properties": {
    "schemaVersion": { "type": "integer", "const": 1 },
    "observationId": { "$ref": "engineering/common.schema.json#/definitions/ref" },
    "kind": { "$ref": "engineering/common.schema.json#/definitions/ref" },
    "controlId": { "$ref": "engineering/common.schema.json#/definitions/controlId" },
    "unitId": { "$ref": "engineering/common.schema.json#/definitions/namespacedId" },
    "source": {
      "type": "object",
      "additionalProperties": false,
      "required": ["collectorId", "version", "mechanism"],
      "properties": {
        "collectorId": { "$ref": "engineering/common.schema.json#/definitions/ref" },
        "version": { "$ref": "engineering/common.schema.json#/definitions/semver" },
        "mechanism": { "type": "string", "enum": ["test", "schema", "static-analysis", "manifest", "manual", "runtime"] },
        "locationRef": { "$ref": "engineering/common.schema.json#/definitions/repoPath" }
      }
    },
    "revision": { "$ref": "engineering/common.schema.json#/definitions/revision" },
    "scopeHash": { "$ref": "engineering/common.schema.json#/definitions/sha256" },
    "configHash": { "$ref": "engineering/common.schema.json#/definitions/sha256" },
    "catalogDigest": { "$ref": "engineering/common.schema.json#/definitions/sha256" },
    "observedAt": { "$ref": "engineering/common.schema.json#/definitions/isoTimestamp" },
    "status": { "type": "string", "enum": ["complete", "partial", "unavailable", "timeout", "invalid", "conflict"] },
    "confidence": { "$ref": "engineering/common.schema.json#/definitions/confidence" },
    "evidenceClass": { "$ref": "engineering/common.schema.json#/definitions/evidenceClass" },
    "facts": { "type": "object" },
    "limitations": { "type": "array", "items": { "$ref": "engineering/common.schema.json#/definitions/diagnostic" } },
    "durationMs": { "type": "integer", "minimum": 0 },
    "cache": { "$ref": "engineering/common.schema.json#/definitions/cache" }
  }
}
