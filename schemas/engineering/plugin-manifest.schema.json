{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "$id": "https://kiritek.dev/schemas/engineering/plugin-manifest.schema.json",
  "title": "Manifest de plugin / control pack engineering",
  "description": "Extensión verificable (R23, T15B): namespace, versión exacta, digest, compatibilidad, perfiles, controles (con permisos y schemas), datos requeridos y archivos con checksum. Sin scripts de instalación.",
  "type": "object",
  "additionalProperties": false,
  "required": ["schemaVersion", "id", "version", "namespace", "engine", "entry", "profiles", "controls", "files", "digest"],
  "properties": {
    "schemaVersion": { "type": "integer", "const": 1 },
    "id": { "$ref": "engineering/common.schema.json#/definitions/namespacedId" },
    "version": { "$ref": "engineering/common.schema.json#/definitions/semver" },
    "namespace": { "type": "string", "pattern": "^[a-z0-9](?:[a-z0-9-]*[a-z0-9])?$" },
    "description": { "type": "string", "maxLength": 500 },
    "engine": {
      "type": "object",
      "additionalProperties": false,
      "required": ["kiritekInit", "pluginContract"],
      "properties": {
        "kiritekInit": { "type": "string", "minLength": 1, "maxLength": 64, "pattern": "^[0-9xX*^~<>=. |-]+$" },
        "pluginContract": { "type": "integer", "const": 1 }
      }
    },
    "entry": { "$ref": "engineering/common.schema.json#/definitions/repoPath" },
    "profiles": {
      "type": "array",
      "maxItems": 50,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["id", "version", "description", "extends"],
        "properties": {
          "id": { "$ref": "engineering/common.schema.json#/definitions/namespacedId" },
          "version": { "$ref": "engineering/common.schema.json#/definitions/semver" },
          "description": { "type": "string", "minLength": 1, "maxLength": 500 },
          "extends": { "type": "array", "items": { "type": "string" } }
        }
      }
    },
    "controls": { "type": "array", "minItems": 1, "maxItems": 50, "items": { "type": "object" } },
    "dataRequests": {
      "type": "array",
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["controlId", "categories", "purpose", "persistence"],
        "properties": {
          "controlId": { "$ref": "engineering/common.schema.json#/definitions/controlId" },
          "categories": { "type": "array", "minItems": 1, "uniqueItems": true, "items": { "type": "string", "enum": ["repository-metadata", "source-structure", "telemetry", "personal-data", "user-content", "credentials"] } },
          "purpose": { "type": "string", "minLength": 10, "maxLength": 500 },
          "persistence": { "type": "string", "enum": ["none", "evidence", "telemetry"] },
          "consentRef": { "type": "string", "minLength": 1, "maxLength": 200 }
        }
      }
    },
    "files": {
      "type": "object",
      "minProperties": 1,
      "propertyNames": { "$ref": "engineering/common.schema.json#/definitions/repoPath" },
      "additionalProperties": { "$ref": "engineering/common.schema.json#/definitions/sha256" }
    },
    "digest": { "$ref": "engineering/common.schema.json#/definitions/sha256" }
  }
}
