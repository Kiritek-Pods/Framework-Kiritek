{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "$id": "https://kiritek.dev/schemas/audit.schema.json",
  "title": "Kiritek Audit Report",
  "type": "object",
  "additionalProperties": false,
  "required": ["schemaVersion", "generatedAt", "capabilities"],
  "properties": {
    "schemaVersion": { "type": "integer", "const": 1 },
    "generatedAt": { "type": "string", "format": "date-time", "minLength": 1 },
    "capabilities": {
      "type": "array",
      "items": { "$ref": "#/definitions/capability" }
    }
  },
  "definitions": {
    "capability": {
      "type": "object",
      "additionalProperties": false,
      "required": ["id", "applicable"],
      "properties": {
        "id": { "type": "string", "minLength": 1 },
        "applicable": { "type": "boolean" },
        "installed": { "type": "boolean" },
        "version": { "type": ["string", "null"] },
        "integrity": { "type": "string", "enum": ["ok", "failed", "unknown"] },
        "configured": { "type": "boolean" },
        "active": { "type": "boolean" },
        "executable": { "type": "boolean" },
        "enforcement": { "type": "string", "enum": ["warning", "enforce", "off", "unknown"] },
        "lastRun": { "type": ["string", "null"], "format": "date-time" },
        "lastResult": { "type": "string", "enum": ["allow", "warn", "deny", "error", "unknown"] },
        "drift": { "type": "boolean" },
        "evidenceRef": { "type": ["string", "null"] },
        "reason": { "type": ["string", "null"] },
        "observation": {
          "type": "string",
          "enum": ["observed", "unauthorized", "not-configured", "not-applicable", "unknown"]
        },
        "lastResultFresh": { "type": ["boolean", "null"] },
        "configHash": { "type": ["string", "null"] },
        "commit": { "type": ["string", "null"] },
        "exceptions": { "type": ["integer", "null"], "minimum": 0 },
        "selfCheck": {
          "type": "object",
          "additionalProperties": false,
          "required": ["ran", "fired"],
          "properties": {
            "ran": { "type": "boolean" },
            "fired": { "type": "boolean" },
            "leaked": { "type": "boolean" },
            "reason": { "type": ["string", "null"] }
          }
        },
        "provider": { "$ref": "#/definitions/providerDetail" }
      }
    },
    "providerDetail": {
      "type": "object",
      "additionalProperties": false,
      "required": ["pack", "selected"],
      "properties": {
        "pack": { "type": "string", "minLength": 1 },
        "selected": { "type": "boolean" },
        "localPresent": { "type": "boolean" },
        "localSource": { "type": ["string", "null"], "enum": ["installed", "templates", null] },
        "localArtifacts": {
          "type": "array",
          "items": { "type": "string" }
        },
        "planId": { "type": "string", "minLength": 1 },
        "dryRun": { "type": "boolean" },
        "applied": { "type": "boolean" },
        "observation": {
          "type": "string",
          "enum": ["observed", "unauthorized", "not-configured", "not-applicable", "unknown"]
        },
        "observationReason": { "type": ["string", "null"] },
        "requiredPermissions": {
          "type": "array",
          "items": {
            "type": "object",
            "additionalProperties": false,
            "required": ["id", "scope", "status"],
            "properties": {
              "id": { "type": "string", "minLength": 1 },
              "scope": { "type": "string", "minLength": 1 },
              "status": {
                "type": "string",
                "enum": ["observed", "unauthorized", "not-configured", "unknown"]
              }
            }
          }
        },
        "capabilityGates": {
          "type": "array",
          "items": {
            "type": "object",
            "additionalProperties": false,
            "required": ["id", "dependsOn", "available"],
            "properties": {
              "id": { "type": "string", "minLength": 1 },
              "dependsOn": { "type": "string", "enum": ["plan", "license", "permissions"] },
              "fallback": { "type": ["string", "null"] },
              "available": {
                "oneOf": [
                  { "type": "boolean" },
                  { "type": "string", "enum": ["unknown"] }
                ]
              },
              "note": { "type": ["string", "null"] }
            }
          }
        },
        "drift": {
          "type": "object",
          "additionalProperties": false,
          "required": ["checked", "drift"],
          "properties": {
            "checked": { "type": "boolean" },
            "drift": { "type": "boolean" },
            "reason": { "type": ["string", "null"] },
            "details": {
              "type": "array",
              "items": {
                "type": "object",
                "additionalProperties": false,
                "required": ["resource", "observed", "drift"],
                "properties": {
                  "resource": { "type": "string", "minLength": 1 },
                  "observed": { "type": "boolean" },
                  "matchesPlan": { "type": ["boolean", "null"] },
                  "drift": { "type": "boolean" },
                  "reason": { "type": ["string", "null"] }
                }
              }
            }
          }
        },
        "ownership": {
          "type": "object",
          "additionalProperties": false,
          "required": ["supported", "protected"],
          "properties": {
            "supported": { "type": "boolean" },
            "protected": { "type": "boolean" },
            "source": { "type": ["string", "null"] },
            "reason": { "type": ["string", "null"] }
          }
        }
      }
    }
  }
}
