{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "$id": "https://kiritek.dev/schemas/inventory.schema.json",
  "title": "Kiritek Install Inventory",
  "type": "object",
  "additionalProperties": false,
  "required": ["schemaVersion", "entries"],
  "properties": {
    "schemaVersion": { "type": "integer", "const": 1 },
    "entries": {
      "type": "object",
      "additionalProperties": { "$ref": "#/definitions/entry" }
    }
  },
  "definitions": {
    "entry": {
      "type": "object",
      "additionalProperties": false,
      "required": ["owner", "strategy", "installedHash"],
      "properties": {
        "owner": { "type": "string", "minLength": 1 },
        "strategy": { "type": "string", "enum": ["owned", "managed-block", "generated", "user-owned"] },
        "installedHash": { "type": "string", "minLength": 1 },
        "version": { "type": ["string", "null"] },
        "installedAt": { "type": "string", "format": "date-time" }
      }
    }
  }
}
