{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "$id": "https://kiritek.dev/schemas/config.schema.json",
  "title": "Kiritek Security Config",
  "type": "object",
  "additionalProperties": false,
  "required": ["version", "mode"],
  "properties": {
    "version": { "type": "integer", "const": 1 },
    "mode": { "type": "string", "enum": ["warning", "enforce"] },
    "defaultBranch": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "explicit": { "type": ["string", "null"] },
        "remote": { "type": "string", "minLength": 1 }
      }
    },
    "secrets": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "gitleaksVersion": { "type": "string", "minLength": 1 },
        "historyDepth": { "type": "string", "enum": ["full", "shallow"] }
      }
    },
    "git": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "blockDirectDefaultPush": { "type": "boolean" },
        "forcePolicy": { "type": "string", "enum": ["deny", "lease-only", "allow"] }
      }
    },
    "commits": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "enabled": { "type": "boolean" },
        "types": {
          "type": "array",
          "items": { "type": "string", "minLength": 1 },
          "minItems": 1
        },
        "requireScope": { "type": "boolean" },
        "maxSubjectLength": { "type": "integer", "minimum": 1 },
        "maxBodyLineLength": { "type": "integer", "minimum": 1 },
        "allowMergeCommits": { "type": "boolean" },
        "allowRevertCommits": { "type": "boolean" }
      }
    },
    "jira": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "enabled": { "type": "boolean" },
        "keyPattern": { "type": "string", "minLength": 1 },
        "unavailable": { "type": "string", "enum": ["fail-closed", "warn"] },
        "locations": {
          "type": "array",
          "items": { "type": "string", "enum": ["commit", "branch", "pr"] }
        },
        "baseUrl": { "type": ["string", "null"] },
        "transport": { "type": "string", "enum": ["rest", "mcp"] },
        "timeoutMs": { "type": "integer", "minimum": 1 },
        "rateLimitPerMinute": { "type": "integer", "minimum": 1 },
        "cacheTtlSeconds": { "type": "integer", "minimum": 0 },
        "requireCredentials": { "type": "boolean" },
        "noJira": {
          "type": "object",
          "additionalProperties": false,
          "properties": {
            "token": { "type": "string", "minLength": 1 },
            "allowedTypes": {
              "type": "array",
              "items": { "type": "string", "minLength": 1 }
            },
            "requireReason": { "type": "boolean" }
          }
        }
      }
    },
    "evidence": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "maxAgeHours": { "type": "number", "exclusiveMinimum": 0 },
        "directory": { "type": "string", "minLength": 1 }
      }
    },
    "telemetry": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "enabled": { "type": "boolean" },
        "budgetMs": { "type": "integer", "minimum": 1 },
        "remote": {
          "type": ["object", "null"],
          "additionalProperties": false,
          "required": [
            "enabled",
            "endpoint",
            "auth",
            "pseudonymousId",
            "timeoutMs",
            "retentionDays",
            "destinationDoc"
          ],
          "properties": {
            "enabled": { "type": "boolean" },
            "endpoint": { "type": "string", "minLength": 1 },
            "auth": {
              "type": "object",
              "additionalProperties": false,
              "required": ["scheme"],
              "properties": {
                "scheme": { "type": "string", "enum": ["Bearer", "Basic", "Token"] },
                "token": { "type": "string", "minLength": 1 }
              }
            },
            "pseudonymousId": { "type": "string", "minLength": 1 },
            "timeoutMs": { "type": "integer", "minimum": 1 },
            "retentionDays": { "type": "integer", "minimum": 1 },
            "destinationDoc": { "type": "string", "minLength": 1 }
          }
        }
      }
    }
  }
}
