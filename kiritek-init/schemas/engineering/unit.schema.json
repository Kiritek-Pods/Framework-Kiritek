{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "$id": "https://kiritek.dev/schemas/engineering/unit.schema.json",
  "title": "Kiritek Engineering Unit",
  "type": "object",
  "additionalProperties": false,
  "required": ["schemaVersion", "id", "root", "kind", "profiles", "owns", "excludes", "dependsOn", "identityAliases", "provenance"],
  "properties": {
    "schemaVersion": { "type": "integer", "const": 1 },
    "id": { "$ref": "engineering/common.schema.json#/definitions/namespacedId" },
    "root": { "$ref": "engineering/common.schema.json#/definitions/repoPath" },
    "kind": { "type": "string", "enum": ["application", "package", "module", "service", "workspace"] },
    "profiles": { "type": "array", "items": { "$ref": "engineering/profile.schema.json" } },
    "owns": { "type": "array", "minItems": 1, "items": { "$ref": "engineering/common.schema.json#/definitions/repoGlob" } },
    "excludes": { "type": "array", "items": { "$ref": "engineering/common.schema.json#/definitions/repoGlob" } },
    "dependsOn": { "type": "array", "uniqueItems": true, "items": { "$ref": "engineering/common.schema.json#/definitions/namespacedId" } },
    "identityAliases": { "type": "array", "uniqueItems": true, "items": { "$ref": "engineering/common.schema.json#/definitions/namespacedId" } },
    "provenance": { "$ref": "engineering/common.schema.json#/definitions/provenance" }
  }
}
