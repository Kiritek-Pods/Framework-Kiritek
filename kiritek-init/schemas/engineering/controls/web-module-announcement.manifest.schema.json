{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "$id": "https://kiritek.dev/schemas/engineering/controls/web-module-announcement.manifest.schema.json",
  "title": "Launch manifest de web.module-announcement",
  "description": "Señal explícita y versionada que vincula módulos con anuncios o N/A gobernado (R11). Contenido por referencia; sin listas de usuarios ni atributos sensibles.",
  "type": "object",
  "additionalProperties": false,
  "required": ["schemaVersion", "control", "modules"],
  "properties": {
    "schemaVersion": { "type": "integer", "const": 1 },
    "control": { "type": "string", "const": "web.module-announcement" },
    "modules": { "type": "array", "minItems": 1, "maxItems": 200, "items": { "$ref": "#/definitions/module" } },
    "announcements": { "type": "array", "maxItems": 200, "items": { "$ref": "#/definitions/announcement" } },
    "governedNa": { "type": "array", "maxItems": 200, "items": { "$ref": "#/definitions/governedNa" } },
    "harness": {
      "anyOf": [
        {
          "type": "object",
          "additionalProperties": false,
          "required": ["kind", "adapter"],
          "properties": { "kind": { "type": "string", "const": "node-adapter" }, "adapter": { "$ref": "engineering/common.schema.json#/definitions/repoPath" } }
        },
        {
          "type": "object",
          "additionalProperties": false,
          "required": ["kind", "command", "args", "traceFile"],
          "properties": {
            "kind": { "type": "string", "const": "trace-command" },
            "command": { "type": "string", "pattern": "^[A-Za-z0-9._-]+$" },
            "args": { "type": "array", "maxItems": 32, "items": { "type": "string", "maxLength": 512 } },
            "traceFile": { "$ref": "engineering/common.schema.json#/definitions/repoPath" }
          }
        }
      ]
    }
  },
  "definitions": {
    "slug": { "type": "string", "pattern": "^[a-z0-9][a-z0-9._-]{0,63}$" },
    "messageRef": { "type": "string", "pattern": "^[a-z0-9][a-z0-9_.-]{0,127}$" },
    "locale": { "type": "string", "pattern": "^[a-z]{2,3}(-[A-Z]{2})?$" },
    "channel": { "type": "string", "pattern": "^[a-z][a-z0-9-]{0,31}$" },
    "module": {
      "type": "object",
      "additionalProperties": false,
      "required": ["moduleId", "announcementRequired"],
      "properties": {
        "moduleId": { "$ref": "#/definitions/slug" },
        "announcementRequired": { "type": "boolean" },
        "announcementId": { "$ref": "#/definitions/slug" },
        "governedNaRef": { "$ref": "#/definitions/slug" }
      }
    },
    "announcement": {
      "type": "object",
      "additionalProperties": false,
      "required": ["id", "version", "window", "owner", "audiences", "channels", "content", "showOnce", "rollout"],
      "properties": {
        "id": { "$ref": "#/definitions/slug" },
        "version": { "type": "integer", "minimum": 1 },
        "window": {
          "type": "object",
          "additionalProperties": false,
          "required": ["start", "end"],
          "properties": { "start": { "$ref": "engineering/common.schema.json#/definitions/isoTimestamp" }, "end": { "$ref": "engineering/common.schema.json#/definitions/isoTimestamp" } }
        },
        "owner": { "$ref": "#/definitions/slug" },
        "audiences": {
          "type": "array",
          "minItems": 1,
          "maxItems": 20,
          "items": {
            "type": "object",
            "additionalProperties": false,
            "required": ["id", "criteria", "channels"],
            "properties": {
              "id": { "$ref": "#/definitions/slug" },
              "criteria": {
                "type": "array",
                "maxItems": 10,
                "items": {
                  "type": "object",
                  "additionalProperties": false,
                  "required": ["attribute", "operator", "values"],
                  "properties": {
                    "attribute": { "type": "string", "pattern": "^[a-z][a-zA-Z0-9_.-]{0,63}$" },
                    "operator": { "type": "string", "enum": ["in", "not-in"] },
                    "values": { "type": "array", "minItems": 1, "maxItems": 20, "items": { "type": "string", "minLength": 1, "maxLength": 64 } }
                  }
                }
              },
              "channels": { "type": "array", "uniqueItems": true, "maxItems": 8, "items": { "$ref": "#/definitions/channel" } },
              "fallbackChannel": { "$ref": "#/definitions/channel" }
            }
          }
        },
        "channels": { "type": "array", "minItems": 1, "uniqueItems": true, "maxItems": 8, "items": { "$ref": "#/definitions/channel" } },
        "content": {
          "type": "object",
          "additionalProperties": false,
          "required": ["titleRef", "bodyRef", "locales", "defaultLocale", "missingContent"],
          "properties": {
            "titleRef": { "$ref": "#/definitions/messageRef" },
            "bodyRef": { "$ref": "#/definitions/messageRef" },
            "locales": { "type": "array", "minItems": 1, "uniqueItems": true, "maxItems": 64, "items": { "$ref": "#/definitions/locale" } },
            "defaultLocale": { "$ref": "#/definitions/locale" },
            "missingContent": { "type": "string", "enum": ["hide", "generic-text"] }
          }
        },
        "showOnce": {
          "type": "object",
          "additionalProperties": false,
          "required": ["key", "audienceScope", "periodDays", "storageUnavailable"],
          "properties": {
            "key": { "$ref": "#/definitions/slug" },
            "audienceScope": { "type": "string", "enum": ["user", "account", "device"] },
            "periodDays": { "type": "integer", "minimum": 1, "maximum": 3650 },
            "storageUnavailable": { "type": "string", "enum": ["suppress", "once-per-session", "show"] }
          }
        },
        "rollout": {
          "type": "object",
          "additionalProperties": false,
          "required": ["state", "history"],
          "properties": {
            "state": { "type": "string", "enum": ["draft", "active", "paused", "retired"] },
            "history": {
              "type": "array",
              "minItems": 1,
              "maxItems": 100,
              "items": {
                "type": "object",
                "additionalProperties": false,
                "required": ["state", "at", "by", "reason"],
                "properties": {
                  "state": { "type": "string", "enum": ["draft", "active", "paused", "retired"] },
                  "at": { "$ref": "engineering/common.schema.json#/definitions/isoTimestamp" },
                  "by": { "$ref": "#/definitions/slug" },
                  "reason": { "type": "string", "minLength": 1, "maxLength": 500 }
                }
              }
            }
          }
        },
        "presentation": {
          "type": "object",
          "additionalProperties": false,
          "properties": { "animated": { "type": "boolean" } }
        }
      }
    },
    "governedNa": {
      "type": "object",
      "additionalProperties": false,
      "required": ["ref", "moduleId", "reason", "scope", "reviewBy", "approval"],
      "properties": {
        "ref": { "$ref": "#/definitions/slug" },
        "moduleId": { "$ref": "#/definitions/slug" },
        "reason": { "type": "string", "minLength": 1, "maxLength": 500 },
        "scope": { "type": "string", "minLength": 1, "maxLength": 200 },
        "reviewBy": { "$ref": "engineering/common.schema.json#/definitions/isoTimestamp" },
        "criticality": { "type": "string", "enum": ["low", "medium", "high"] },
        "approval": {
          "type": "object",
          "additionalProperties": false,
          "required": ["by", "ref"],
          "properties": { "by": { "$ref": "#/definitions/slug" }, "ref": { "type": "string", "minLength": 1, "maxLength": 200 }, "secondBy": { "$ref": "#/definitions/slug" } }
        }
      }
    }
  }
}
