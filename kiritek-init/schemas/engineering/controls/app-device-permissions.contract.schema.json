{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "$id": "https://kiritek.dev/schemas/engineering/controls/app-device-permissions.contract.schema.json",
  "title": "Contrato de permisos del dispositivo (app.device-permissions)",
  "description": "Permisos que pide la app, para qué funcionalidad y si debe ofrecer una alternativa cuando el usuario los niega.",
  "type": "object",
  "additionalProperties": false,
  "required": ["schemaVersion", "control", "permissions"],
  "properties": {
    "$schema": { "type": "string" },
    "schemaVersion": { "type": "integer", "const": 1 },
    "control": { "type": "string", "const": "app.device-permissions" },
    "permissions": {
      "type": "array",
      "minItems": 1,
      "maxItems": 20,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["id", "kind", "fallback"],
        "properties": {
          "id": { "type": "string", "pattern": "^[a-z][a-z0-9-]*$", "maxLength": 64 },
          "kind": { "type": "string", "enum": ["camera", "microphone", "location", "notifications", "photos", "contacts", "bluetooth", "calendar"] },
          "fallback": { "type": "string", "enum": ["required", "not-applicable"] }
        }
      }
    },
    "harness": { "$ref": "engineering/controls/harness.schema.json#/definitions/harness" }
  }
}
