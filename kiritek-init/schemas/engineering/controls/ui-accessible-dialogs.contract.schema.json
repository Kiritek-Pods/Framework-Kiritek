{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "$id": "https://kiritek.dev/schemas/engineering/controls/ui-accessible-dialogs.contract.schema.json",
  "title": "Contrato de diálogos (ui.accessible-dialogs)",
  "description": "Modales, menús y paneles laterales de la app, y si se pueden cerrar con Escape o clic afuera.",
  "type": "object",
  "additionalProperties": false,
  "required": ["schemaVersion", "control", "dialogs"],
  "properties": {
    "$schema": { "type": "string" },
    "schemaVersion": { "type": "integer", "const": 1 },
    "control": { "type": "string", "const": "ui.accessible-dialogs" },
    "dialogs": {
      "type": "array",
      "minItems": 1,
      "maxItems": 50,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["id", "kind", "dismissible"],
        "properties": {
          "id": { "type": "string", "pattern": "^[a-z][a-z0-9-]*$", "maxLength": 64 },
          "kind": { "type": "string", "enum": ["modal", "menu", "drawer"] },
          "dismissible": { "type": "boolean" }
        }
      }
    },
    "harness": { "$ref": "engineering/controls/harness.schema.json#/definitions/harness" }
  }
}
