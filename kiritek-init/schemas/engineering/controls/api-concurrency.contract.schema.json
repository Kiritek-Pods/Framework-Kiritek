{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "$id": "https://kiritek.dev/schemas/engineering/controls/api-concurrency.contract.schema.json",
  "title": "Contrato de edición concurrente (api.concurrency)",
  "description": "Recursos editables con su ruta (con :id), método de actualización y cómo viaja la versión (ETag/If-Match o un campo del cuerpo).",
  "type": "object",
  "additionalProperties": false,
  "required": ["schemaVersion", "control", "resources"],
  "properties": {
    "$schema": { "type": "string" },
    "schemaVersion": { "type": "integer", "const": 1 },
    "control": { "type": "string", "const": "api.concurrency" },
    "resources": {
      "type": "array",
      "minItems": 1,
      "maxItems": 50,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["id", "path", "mode"],
        "properties": {
          "id": { "type": "string", "pattern": "^[a-z][a-z0-9-]*$", "maxLength": 64 },
          "path": { "type": "string", "pattern": "^/[A-Za-z0-9/_.-]*:id[A-Za-z0-9/_.-]*$", "maxLength": 200 },
          "method": { "type": "string", "enum": ["PUT", "PATCH"] },
          "mode": { "type": "string", "enum": ["etag", "version-field"] },
          "versionField": { "type": "string", "pattern": "^[a-zA-Z][a-zA-Z0-9_]*$" },
          "field": { "type": "string", "pattern": "^[a-zA-Z][a-zA-Z0-9_]*$" },
          "requirePrecondition": { "type": "boolean" }
        }
      }
    },
    "harness": { "$ref": "engineering/controls/harness.schema.json#/definitions/harness" }
  }
}
