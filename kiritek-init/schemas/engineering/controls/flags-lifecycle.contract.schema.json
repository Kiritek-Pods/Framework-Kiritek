{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "$id": "https://kiritek.dev/schemas/engineering/controls/flags-lifecycle.contract.schema.json",
  "title": "Registro de feature flags (flags.lifecycle)",
  "description": "Cada flag con dueño, tipo, fechas y valor por defecto seguro. `client` declara el cliente propio del equipo (timeout y refresco); sin `client` sólo se evalúa el registro.",
  "type": "object",
  "additionalProperties": false,
  "required": ["schemaVersion", "control", "flags"],
  "properties": {
    "$schema": { "type": "string" },
    "schemaVersion": { "type": "integer", "const": 1 },
    "control": { "type": "string", "const": "flags.lifecycle" },
    "flags": {
      "type": "array",
      "minItems": 1,
      "maxItems": 500,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["key", "owner", "kind", "createdAt", "defaultValue"],
        "properties": {
          "key": { "type": "string", "pattern": "^[a-z0-9][a-z0-9._-]*$", "maxLength": 96 },
          "owner": { "type": "string", "pattern": "^[a-z0-9][a-z0-9._/-]*$", "maxLength": 64 },
          "kind": { "type": "string", "enum": ["release", "experiment", "ops", "permission"] },
          "createdAt": { "type": "string", "format": "date-time" },
          "removeBy": { "type": "string", "format": "date-time" },
          "defaultValue": { "anyOf": [{ "type": "boolean" }, { "type": "number" }, { "type": "string", "pattern": "^[A-Za-z0-9._-]+$", "maxLength": 64 }] },
          "killSwitch": { "type": "boolean" }
        }
      }
    },
    "client": {
      "type": "object",
      "additionalProperties": false,
      "required": ["timeoutMs", "refreshSeconds"],
      "properties": {
        "timeoutMs": { "type": "integer", "minimum": 50, "maximum": 30000 },
        "refreshSeconds": { "type": "integer", "minimum": 1, "maximum": 86400 }
      }
    },
    "harness": { "$ref": "engineering/controls/harness.schema.json#/definitions/harness" }
  }
}
