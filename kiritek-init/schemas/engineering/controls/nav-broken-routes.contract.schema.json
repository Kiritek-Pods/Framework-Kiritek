{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "$id": "https://kiritek.dev/schemas/engineering/controls/nav-broken-routes.contract.schema.json",
  "title": "Contrato de rutas (nav.broken-routes)",
  "description": "Rutas de la app (con parámetros), cuáles exigen sesión y si los enlaces profundos deben sobrevivir al login.",
  "type": "object",
  "additionalProperties": false,
  "required": ["schemaVersion", "control", "routes", "deepLinks"],
  "properties": {
    "$schema": { "type": "string" },
    "schemaVersion": { "type": "integer", "const": 1 },
    "control": { "type": "string", "const": "nav.broken-routes" },
    "routes": {
      "type": "array",
      "minItems": 1,
      "maxItems": 200,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["path", "auth"],
        "properties": {
          "path": { "type": "string", "pattern": "^/(?:[a-z0-9-]+|:[a-zA-Z][a-zA-Z0-9]*)?(?:/(?:[a-z0-9-]+|:[a-zA-Z][a-zA-Z0-9]*))*$", "maxLength": 200 },
          "auth": { "type": "boolean" }
        }
      }
    },
    "deepLinks": { "type": "string", "enum": ["required", "not-applicable"] },
    "harness": { "$ref": "engineering/controls/harness.schema.json#/definitions/harness" }
  }
}
