{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "$id": "https://kiritek.dev/schemas/engineering/controls/ui-file-upload.contract.schema.json",
  "title": "Contrato de subidas de archivos (ui.file-upload)",
  "description": "Puntos de subida con tamaño máximo, tipos aceptados y si deben permitir cancelar y reintentar.",
  "type": "object",
  "additionalProperties": false,
  "required": ["schemaVersion", "control", "uploads"],
  "properties": {
    "$schema": { "type": "string" },
    "schemaVersion": { "type": "integer", "const": 1 },
    "control": { "type": "string", "const": "ui.file-upload" },
    "uploads": {
      "type": "array",
      "minItems": 1,
      "maxItems": 50,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["id", "maxBytes", "accept", "cancel", "retry"],
        "properties": {
          "id": { "type": "string", "pattern": "^[a-z][a-z0-9-]*$", "maxLength": 64 },
          "maxBytes": { "type": "integer", "minimum": 1, "maximum": 10737418240 },
          "accept": { "type": "array", "minItems": 1, "maxItems": 30, "uniqueItems": true, "items": { "type": "string", "pattern": "^(?:\\*|[a-z]+)/(?:\\*|[a-z0-9.+-]+)$" } },
          "cancel": { "type": "string", "enum": ["required", "not-applicable"] },
          "retry": { "type": "string", "enum": ["required", "not-applicable"] }
        }
      }
    },
    "harness": { "$ref": "engineering/controls/harness.schema.json#/definitions/harness" }
  }
}
