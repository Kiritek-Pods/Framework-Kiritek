{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "$id": "https://kiritek.dev/schemas/engineering/controls/api-versioning.contract.schema.json",
  "title": "Contrato de versionado de API (api.versioning)",
  "description": "Cómo viaja la versión (prefijo de ruta o header), versiones con su estado y fecha de retiro, campos que cada versión garantiza y endpoints a ejercitar.",
  "type": "object",
  "additionalProperties": false,
  "required": ["schemaVersion", "control", "scheme", "versions", "endpoints"],
  "properties": {
    "$schema": { "type": "string" },
    "schemaVersion": { "type": "integer", "const": 1 },
    "control": { "type": "string", "const": "api.versioning" },
    "scheme": { "type": "string", "enum": ["path", "header"] },
    "header": { "type": "string", "pattern": "^[A-Za-z][A-Za-z0-9-]*$", "maxLength": 64 },
    "versions": {
      "type": "array",
      "minItems": 1,
      "maxItems": 20,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["id", "status"],
        "properties": {
          "id": { "type": "string", "pattern": "^[a-z0-9][a-z0-9.-]*$", "maxLength": 32 },
          "status": { "type": "string", "enum": ["supported", "deprecated", "retired"] },
          "sunset": { "type": "string", "pattern": "^\\d{4}-\\d{2}-\\d{2}$" },
          "requiredFields": { "type": "array", "maxItems": 50, "items": { "type": "string", "pattern": "^[a-zA-Z_][a-zA-Z0-9_]*$" } }
        }
      }
    },
    "endpoints": {
      "type": "array",
      "minItems": 1,
      "maxItems": 50,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["id", "path"],
        "properties": {
          "id": { "type": "string", "pattern": "^[a-z][a-z0-9-]*$", "maxLength": 64 },
          "path": { "type": "string", "pattern": "^/[A-Za-z0-9/_.-]*$", "maxLength": 200 }
        }
      }
    },
    "harness": { "$ref": "engineering/controls/harness.schema.json#/definitions/harness" }
  }
}
