{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "$id": "https://kiritek.dev/schemas/engineering/controls/svc-startup-config.contract.schema.json",
  "title": "Contrato de configuración al arrancar (svc.startup-config)",
  "description": "Variables de entorno del servicio con su tipo, si son obligatorias y, opcionalmente, valores permitidos y un valor de ejemplo válido.",
  "type": "object",
  "additionalProperties": false,
  "required": ["schemaVersion", "control", "variables"],
  "properties": {
    "$schema": { "type": "string" },
    "schemaVersion": { "type": "integer", "const": 1 },
    "control": { "type": "string", "const": "svc.startup-config" },
    "variables": {
      "type": "array",
      "minItems": 1,
      "maxItems": 100,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["name", "kind"],
        "properties": {
          "name": { "type": "string", "pattern": "^[A-Z][A-Z0-9_]*$", "maxLength": 64 },
          "kind": { "type": "string", "enum": ["string", "url", "int", "enum", "bool", "secret"] },
          "required": { "type": "boolean" },
          "values": { "type": "array", "maxItems": 50, "items": { "type": "string", "maxLength": 64 } },
          "example": { "type": "string", "maxLength": 200 }
        }
      }
    },
    "harness": { "$ref": "engineering/controls/harness.schema.json#/definitions/harness" }
  }
}
