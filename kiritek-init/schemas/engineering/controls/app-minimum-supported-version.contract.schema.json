{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "$id": "https://kiritek.dev/schemas/engineering/controls/app-minimum-supported-version.contract.schema.json",
  "title": "Contrato de política de versión mínima (app.minimum-supported-version)",
  "description": "Forma del contrato. Las reglas semánticas (gracia con tiempo confiable, rollback sin release, override gobernado, observabilidad…) las evalúa el control como findings deterministas.",
  "type": "object",
  "additionalProperties": false,
  "required": ["schemaVersion", "control", "versionScheme", "environments", "offline", "grace", "hard", "soft", "stores", "rollback", "override", "observability", "harness"],
  "properties": {
    "$schema": { "type": "string" },
    "schemaVersion": { "type": "integer", "const": 1 },
    "control": { "type": "string", "const": "app.minimum-supported-version" },
    "versionScheme": { "type": "string", "enum": ["semver"] },
    "environments": {
      "type": "object",
      "minProperties": 1,
      "propertyNames": { "type": "string", "pattern": "^[a-z][a-z0-9-]*$" },
      "additionalProperties": {
        "type": "object",
        "additionalProperties": false,
        "required": ["source", "cacheTtlSeconds", "staleIfOfflineSeconds", "timeoutMs"],
        "properties": {
          "source": {
            "type": "object",
            "additionalProperties": false,
            "required": ["kind", "authenticity"],
            "properties": {
              "kind": { "type": "string", "enum": ["remote-config", "https-json", "bundled"] },
              "authenticity": { "type": "string", "enum": ["signature", "provider-auth", "tls-pinning", "none"] },
              "keyId": { "type": "string", "pattern": "^[A-Za-z0-9._-]+$" }
            }
          },
          "cacheTtlSeconds": { "type": "integer", "minimum": 0, "maximum": 2592000 },
          "staleIfOfflineSeconds": { "type": "integer", "minimum": 0, "maximum": 2592000 },
          "timeoutMs": { "type": "integer", "minimum": 100, "maximum": 60000 }
        }
      }
    },
    "offline": {
      "type": "object",
      "additionalProperties": false,
      "required": ["firstRun", "expiredCache"],
      "properties": {
        "firstRun": { "type": "string", "enum": ["allow-with-warning", "block-with-explanation"] },
        "expiredCache": { "type": "string", "enum": ["allow-with-warning", "use-stale-with-warning", "block-with-explanation"] }
      }
    },
    "grace": {
      "type": "object",
      "additionalProperties": false,
      "required": ["allowed"],
      "properties": {
        "allowed": { "type": "boolean" },
        "timeSource": { "type": "string", "enum": ["server", "signed-timestamp", "local"] },
        "maxDays": { "type": "integer", "minimum": 1, "maximum": 365 },
        "audience": { "type": "string", "enum": ["all", "segment"] }
      }
    },
    "hard": {
      "type": "object",
      "additionalProperties": false,
      "required": ["explainReason", "exitWhenStoreUnavailable"],
      "properties": {
        "explainReason": { "type": "boolean" },
        "exitWhenStoreUnavailable": { "type": "string", "enum": ["fallback-link", "support-contact", "allow-continue", "none"] }
      }
    },
    "soft": {
      "type": "object",
      "additionalProperties": false,
      "required": ["allowContinue", "postponeFrequencyHours"],
      "properties": {
        "allowContinue": { "type": "boolean" },
        "postponeFrequencyHours": { "type": "integer", "minimum": 0, "maximum": 8760 }
      }
    },
    "stores": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["platform", "store", "fallback"],
        "properties": {
          "platform": { "type": "string", "enum": ["ios", "android", "huawei", "enterprise"] },
          "store": { "type": "string", "enum": ["app-store", "play-store", "app-gallery", "mdm"] },
          "fallback": { "type": "string", "enum": ["web-download", "support-contact", "none"] }
        }
      }
    },
    "rollback": {
      "type": "object",
      "additionalProperties": false,
      "required": ["mechanism", "requiresAppRelease"],
      "properties": {
        "mechanism": { "type": "string", "enum": ["remote-policy-revert", "config-flag", "app-release"] },
        "requiresAppRelease": { "type": "boolean" }
      }
    },
    "override": {
      "type": "object",
      "additionalProperties": false,
      "required": ["authenticated", "scopedBy", "maxDurationHours", "audited", "reversible"],
      "properties": {
        "authenticated": { "type": "boolean" },
        "scopedBy": { "type": "array", "uniqueItems": true, "items": { "type": "string", "enum": ["environment", "audience", "platform"] } },
        "maxDurationHours": { "type": "integer", "minimum": 1, "maximum": 8760 },
        "audited": { "type": "boolean" },
        "reversible": { "type": "boolean" }
      }
    },
    "observability": {
      "type": "object",
      "additionalProperties": false,
      "required": ["events", "identifiers"],
      "properties": {
        "events": { "type": "array", "uniqueItems": true, "items": { "type": "string", "enum": ["fetch", "parse", "cache", "decision", "store", "override"] } },
        "identifiers": { "type": "string", "enum": ["none", "pseudonymous", "raw"] }
      }
    },
    "harness": {
      "anyOf": [
        {
          "type": "object",
          "additionalProperties": false,
          "required": ["kind", "adapter"],
          "properties": { "kind": { "type": "string", "const": "node-adapter" }, "adapter": { "$ref": "engineering/common.schema.json#/definitions/repoPath" } }
        },
        {
          "type": "object",
          "additionalProperties": false,
          "required": ["kind", "command", "args", "traceFile"],
          "properties": {
            "kind": { "type": "string", "const": "trace-command" },
            "command": { "type": "string", "pattern": "^[A-Za-z0-9._-]+$" },
            "args": { "type": "array", "maxItems": 32, "items": { "type": "string", "maxLength": 512 } },
            "traceFile": { "$ref": "engineering/common.schema.json#/definitions/repoPath" }
          }
        }
      ]
    }
  }
}
