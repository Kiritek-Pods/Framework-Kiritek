{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "$id": "https://kiritek.dev/schemas/engineering/controls/api-batch.contract.schema.json",
  "title": "Contrato de operaciones en lote (api.batch)",
  "description": "Endpoints de lote con su modo (partial o atomic), tope de ítems, nombres de campos y un ítem válido y uno inválido de ejemplo.",
  "type": "object",
  "additionalProperties": false,
  "required": ["schemaVersion", "control", "endpoints"],
  "properties": {
    "$schema": { "type": "string" },
    "schemaVersion": { "type": "integer", "const": 1 },
    "control": { "type": "string", "const": "api.batch" },
    "endpoints": {
      "type": "array",
      "minItems": 1,
      "maxItems": 20,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["id", "path", "mode", "maxItems", "sampleItem", "invalidItem"],
        "properties": {
          "id": { "type": "string", "pattern": "^[a-z][a-z0-9-]*$", "maxLength": 64 },
          "method": { "type": "string", "enum": ["POST", "PUT", "PATCH"] },
          "path": { "type": "string", "pattern": "^/[A-Za-z0-9/_.:-]*$", "maxLength": 200 },
          "mode": { "type": "string", "enum": ["partial", "atomic"] },
          "maxItems": { "type": "integer", "minimum": 3, "maximum": 10000 },
          "itemsField": { "type": "string", "pattern": "^[a-zA-Z][a-zA-Z0-9_]*$" },
          "resultsField": { "type": "string", "pattern": "^[a-zA-Z][a-zA-Z0-9_]*$" },
          "refField": { "type": "string", "pattern": "^[a-zA-Z][a-zA-Z0-9_]*$" },
          "sampleItem": { "type": "object", "maxProperties": 30 },
          "invalidItem": { "type": "object", "maxProperties": 30 }
        }
      }
    },
    "harness": { "$ref": "engineering/controls/harness.schema.json#/definitions/harness" }
  }
}
