{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "$id": "https://kiritek.dev/schemas/engineering/controls/svc-metrics.contract.schema.json",
  "title": "Contrato de métricas del servicio (svc.metrics)",
  "description": "Ruta de exposición Prometheus, nombres del contador de requests y del histograma de duración, nombres de labels y endpoints (como plantilla de ruta) a ejercitar.",
  "type": "object",
  "additionalProperties": false,
  "required": ["schemaVersion", "control", "names", "endpoints"],
  "properties": {
    "$schema": { "type": "string" },
    "schemaVersion": { "type": "integer", "const": 1 },
    "control": { "type": "string", "const": "svc.metrics" },
    "metricsPath": { "type": "string", "pattern": "^/[A-Za-z0-9/_.-]*$", "maxLength": 100 },
    "names": {
      "type": "object",
      "additionalProperties": false,
      "required": ["requests", "duration"],
      "properties": {
        "requests": { "type": "string", "pattern": "^[a-zA-Z_:][a-zA-Z0-9_:]*$", "maxLength": 100 },
        "duration": { "type": "string", "pattern": "^[a-zA-Z_:][a-zA-Z0-9_:]*$", "maxLength": 100 }
      }
    },
    "labels": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "route": { "type": "string", "pattern": "^[a-zA-Z_][a-zA-Z0-9_]*$" },
        "method": { "type": "string", "pattern": "^[a-zA-Z_][a-zA-Z0-9_]*$" },
        "status": { "type": "string", "pattern": "^[a-zA-Z_][a-zA-Z0-9_]*$" }
      }
    },
    "endpoints": {
      "type": "array",
      "minItems": 1,
      "maxItems": 20,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["id", "method", "route"],
        "properties": {
          "id": { "type": "string", "pattern": "^[a-z][a-z0-9-]*$", "maxLength": 64 },
          "method": { "type": "string", "enum": ["GET", "POST", "PUT", "PATCH", "DELETE"] },
          "route": { "type": "string", "pattern": "^/[A-Za-z0-9/_.:-]*$", "maxLength": 200 }
        }
      }
    },
    "harness": { "$ref": "engineering/controls/harness.schema.json#/definitions/harness" }
  }
}
