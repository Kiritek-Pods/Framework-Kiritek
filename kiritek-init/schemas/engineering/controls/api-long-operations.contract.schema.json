{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "$id": "https://kiritek.dev/schemas/engineering/controls/api-long-operations.contract.schema.json",
  "title": "Contrato de operaciones largas (api.long-operations)",
  "description": "Operaciones que responden 202: ruta de inicio, ruta de estado (con :id), campo y valores del estado y duración máxima.",
  "type": "object",
  "additionalProperties": false,
  "required": ["schemaVersion", "control", "operations"],
  "properties": {
    "$schema": { "type": "string" },
    "schemaVersion": { "type": "integer", "const": 1 },
    "control": { "type": "string", "const": "api.long-operations" },
    "operations": {
      "type": "array",
      "minItems": 1,
      "maxItems": 20,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["id", "path", "statusPath", "maxDurationMs"],
        "properties": {
          "id": { "type": "string", "pattern": "^[a-z][a-z0-9-]*$", "maxLength": 64 },
          "method": { "type": "string", "enum": ["POST", "PUT", "PATCH", "DELETE"] },
          "path": { "type": "string", "pattern": "^/[A-Za-z0-9/_.:-]*$", "maxLength": 200 },
          "statusPath": { "type": "string", "pattern": "^/[A-Za-z0-9/_.-]*:id[A-Za-z0-9/_.-]*$", "maxLength": 200 },
          "sampleBody": { "type": "object", "maxProperties": 30 },
          "statusField": { "type": "string", "pattern": "^[a-zA-Z][a-zA-Z0-9_]*$" },
          "doneValue": { "type": "string", "pattern": "^[a-zA-Z][a-zA-Z0-9_-]*$", "maxLength": 32 },
          "failedValue": { "type": "string", "pattern": "^[a-zA-Z][a-zA-Z0-9_-]*$", "maxLength": 32 },
          "maxDurationMs": { "type": "integer", "minimum": 1000, "maximum": 86400000 }
        }
      }
    },
    "harness": { "$ref": "engineering/controls/harness.schema.json#/definitions/harness" }
  }
}
