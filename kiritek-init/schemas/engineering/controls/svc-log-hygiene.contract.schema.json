{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "$id": "https://kiritek.dev/schemas/engineering/controls/svc-log-hygiene.contract.schema.json",
  "title": "Contrato de logs (svc.log-hygiene)",
  "description": "Formato de los logs del servicio (nombres de los campos de nivel, mensaje e id de correlación), header de correlación y endpoints a ejercitar con cuerpos sintéticos.",
  "type": "object",
  "additionalProperties": false,
  "required": ["schemaVersion", "control", "correlationHeader", "fields", "endpoints"],
  "properties": {
    "$schema": { "type": "string" },
    "schemaVersion": { "type": "integer", "const": 1 },
    "control": { "type": "string", "const": "svc.log-hygiene" },
    "correlationHeader": { "type": "string", "pattern": "^[A-Za-z][A-Za-z0-9-]*$", "maxLength": 64 },
    "fields": {
      "type": "object",
      "additionalProperties": false,
      "required": ["level", "message", "requestId"],
      "properties": {
        "level": { "type": "string", "pattern": "^[a-zA-Z][a-zA-Z0-9_.]*$" },
        "message": { "type": "string", "pattern": "^[a-zA-Z][a-zA-Z0-9_.]*$" },
        "requestId": { "type": "string", "pattern": "^[a-zA-Z][a-zA-Z0-9_.]*$" }
      }
    },
    "endpoints": {
      "type": "array",
      "minItems": 1,
      "maxItems": 20,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["id", "method", "path"],
        "properties": {
          "id": { "type": "string", "pattern": "^[a-z][a-z0-9-]*$", "maxLength": 64 },
          "method": { "type": "string", "enum": ["GET", "POST", "PUT", "PATCH", "DELETE"] },
          "path": { "type": "string", "pattern": "^/[A-Za-z0-9/_.:-]*$", "maxLength": 200 },
          "sampleBody": { "type": "object", "maxProperties": 30 }
        }
      }
    },
    "harness": { "$ref": "engineering/controls/harness.schema.json#/definitions/harness" }
  }
}
