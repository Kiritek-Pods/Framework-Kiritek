{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "$id": "https://kiritek.dev/schemas/engineering/controls/ui-pagination.contract.schema.json",
  "title": "Contrato de listas paginadas (ui.pagination)",
  "description": "Listas largas con tamaño de página, modo (cursor u offset) y si deben mostrar el fin de la lista.",
  "type": "object",
  "additionalProperties": false,
  "required": ["schemaVersion", "control", "lists"],
  "properties": {
    "$schema": { "type": "string" },
    "schemaVersion": { "type": "integer", "const": 1 },
    "control": { "type": "string", "const": "ui.pagination" },
    "lists": {
      "type": "array",
      "minItems": 1,
      "maxItems": 50,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["id", "pageSize", "mode", "endState"],
        "properties": {
          "id": { "type": "string", "pattern": "^[a-z][a-z0-9-]*$", "maxLength": 64 },
          "pageSize": { "type": "integer", "minimum": 1, "maximum": 500 },
          "mode": { "type": "string", "enum": ["cursor", "offset"] },
          "endState": { "type": "string", "enum": ["required", "not-applicable"] }
        }
      }
    },
    "harness": { "$ref": "engineering/controls/harness.schema.json#/definitions/harness" }
  }
}
