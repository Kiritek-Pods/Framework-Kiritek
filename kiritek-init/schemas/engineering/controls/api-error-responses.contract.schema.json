{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "$id": "https://kiritek.dev/schemas/engineering/controls/api-error-responses.contract.schema.json",
  "title": "Contrato de errores de API (api.error-responses)",
  "description": "Formato de error de la API y endpoints con un cuerpo válido y cuerpos inválidos, todos sintéticos, para probar validación y fallas internas.",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schemaVersion",
    "control",
    "errorFormat",
    "endpoints"
  ],
  "properties": {
    "$schema": {
      "type": "string"
    },
    "schemaVersion": {
      "type": "integer",
      "const": 1
    },
    "control": {
      "type": "string",
      "const": "api.error-responses"
    },
    "errorFormat": {
      "type": "string",
      "enum": [
        "problem+json",
        "custom"
      ]
    },
    "errorFields": {
      "type": "array",
      "minItems": 1,
      "maxItems": 10,
      "uniqueItems": true,
      "items": {
        "type": "string",
        "pattern": "^[a-zA-Z][a-zA-Z0-9_]*$"
      }
    },
    "endpoints": {
      "type": "array",
      "minItems": 1,
      "maxItems": 50,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "id",
          "method",
          "path",
          "sampleBody",
          "invalidBodies"
        ],
        "properties": {
          "id": {
            "type": "string",
            "pattern": "^[a-z][a-z0-9-]*$",
            "maxLength": 64
          },
          "method": {
            "type": "string",
            "enum": [
              "POST",
              "PUT",
              "PATCH"
            ]
          },
          "path": {
            "type": "string",
            "pattern": "^/[A-Za-z0-9/_.:-]*$",
            "maxLength": 200
          },
          "sampleBody": {
            "type": "object",
            "maxProperties": 30
          },
          "invalidBodies": {
            "type": "array",
            "minItems": 1,
            "maxItems": 5,
            "items": {
              "type": "object",
              "maxProperties": 30
            }
          }
        }
      }
    },
    "harness": {
      "$ref": "engineering/controls/harness.schema.json#/definitions/harness"
    }
  }
}
