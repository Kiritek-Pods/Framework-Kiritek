{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "$id": "https://kiritek.dev/schemas/engineering/config.schema.json",
  "title": "Kiritek Engineering Guardrails — configuración (kiritek-engineering.config.json)",
  "description": "Configuración independiente de kiritek-security.config.json. Niveles off|warn|enforce por control; precedencia flags > env > unidad > repo > organización verificada > catálogo.",
  "type": "object",
  "additionalProperties": false,
  "required": ["schemaVersion", "pack", "workspace"],
  "properties": {
    "$schema": { "type": "string", "minLength": 1 },
    "schemaVersion": { "type": "integer", "const": 1 },
    "pack": {
      "type": "object",
      "additionalProperties": false,
      "required": ["id", "catalog"],
      "properties": {
        "id": { "type": "string", "const": "engineering/guardrails" },
        "catalog": { "$ref": "engineering/common.schema.json#/definitions/semver" },
        "catalogDigest": { "$ref": "engineering/common.schema.json#/definitions/sha256" }
      }
    },
    "organization": {
      "type": "object",
      "additionalProperties": false,
      "required": ["source", "trustKeyId", "required"],
      "properties": {
        "source": { "type": "string", "pattern": "^https://[^\\s/@]+(?:/[^\\s?#@]*)?$" },
        "trustKeyId": { "type": "string", "pattern": "^[A-Za-z0-9._-]+$" },
        "required": { "type": "boolean" }
      }
    },
    "workspace": {
      "type": "object",
      "additionalProperties": false,
      "required": ["units"],
      "properties": {
        "inheritProfiles": { "type": "boolean" },
        "profiles": { "type": "array", "items": { "$ref": "#/definitions/profileDecl" } },
        "sharedPaths": { "type": "array", "uniqueItems": true, "items": { "$ref": "engineering/common.schema.json#/definitions/repoGlob" } },
        "onAmbiguousImpact": { "type": "string", "enum": ["expand", "require-explicit"] },
        "units": { "type": "array", "items": { "$ref": "#/definitions/unitDecl" } }
      }
    },
    "defaults": {
      "type": "object",
      "additionalProperties": false,
      "properties": { "controls": { "$ref": "#/definitions/controlMap" } }
    },
    "execution": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "maxProcesses": { "type": "integer", "minimum": 1, "maximum": 64 },
        "maxMemoryMb": { "type": "integer", "minimum": 128, "maximum": 65536 },
        "budgetsMs": {
          "type": "object",
          "additionalProperties": false,
          "properties": {
            "agent": { "type": "integer", "minimum": 1, "maximum": 1500 },
            "pre-commit": { "type": "integer", "minimum": 1, "maximum": 5000 },
            "pr": { "type": "integer", "minimum": 1, "maximum": 600000 },
            "release": { "type": "integer", "minimum": 1, "maximum": 900000 }
          }
        },
        "offline": { "type": "boolean" },
        "cacheDirectory": { "$ref": "engineering/common.schema.json#/definitions/repoPath" }
      }
    },
    "evidence": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "directory": { "$ref": "engineering/common.schema.json#/definitions/repoPath" },
        "retentionDays": { "type": "integer", "minimum": 1, "maximum": 3650 }
      }
    },
    "exceptions": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "waiverFiles": { "type": "array", "items": { "$ref": "engineering/common.schema.json#/definitions/repoGlob" } },
        "notApplicableFiles": { "type": "array", "items": { "$ref": "engineering/common.schema.json#/definitions/repoGlob" } },
        "maxWaiverDays": { "type": "integer", "minimum": 1, "maximum": 180 },
        "maxNaReviewDays": { "type": "integer", "minimum": 1, "maximum": 730 },
        "requireDistinctApprover": { "type": "boolean" },
        "naApproval": { "type": "string", "enum": ["always", "high-criticality"] }
      }
    },
    "telemetry": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "enabled": { "type": "boolean" },
        "endpoint": {
          "anyOf": [
            { "type": "null" },
            { "type": "string", "pattern": "^https://[^\\s/@?#]+(?:/[^\\s?#@]*)?$" }
          ]
        },
        "retentionDays": { "type": "integer", "minimum": 1, "maximum": 365 },
        "categories": {
          "type": "array",
          "uniqueItems": true,
          "items": { "type": "string", "enum": ["control-status", "duration", "cache", "error-category"] }
        }
      }
    },
    "plugins": {
      "type": "array",
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["id", "version", "digest"],
        "properties": {
          "id": { "$ref": "engineering/common.schema.json#/definitions/namespacedId" },
          "version": { "$ref": "engineering/common.schema.json#/definitions/semver" },
          "digest": { "$ref": "engineering/common.schema.json#/definitions/sha256" }
        }
      }
    }
  },
  "definitions": {
    "profileDecl": {
      "type": "object",
      "additionalProperties": false,
      "required": ["id", "version"],
      "properties": {
        "id": { "$ref": "engineering/common.schema.json#/definitions/profileId" },
        "version": { "$ref": "engineering/common.schema.json#/definitions/semver" },
        "parameters": { "type": "object" }
      }
    },
    "controlSetting": {
      "type": "object",
      "additionalProperties": false,
      "minProperties": 1,
      "properties": {
        "level": { "$ref": "engineering/common.schema.json#/definitions/level" },
        "parameters": { "type": "object" }
      }
    },
    "controlMap": {
      "type": "object",
      "propertyNames": { "$ref": "engineering/common.schema.json#/definitions/controlId" },
      "additionalProperties": { "$ref": "#/definitions/controlSetting" }
    },
    "unitDecl": {
      "type": "object",
      "additionalProperties": false,
      "required": ["id", "root", "kind", "profiles", "owns"],
      "properties": {
        "id": { "$ref": "engineering/common.schema.json#/definitions/namespacedId" },
        "root": { "$ref": "engineering/common.schema.json#/definitions/repoPath" },
        "kind": { "type": "string", "enum": ["application", "package", "module", "service", "workspace"] },
        "inheritProfiles": { "type": "boolean" },
        "profiles": { "type": "array", "items": { "$ref": "#/definitions/profileDecl" } },
        "owns": { "type": "array", "minItems": 1, "items": { "$ref": "engineering/common.schema.json#/definitions/repoGlob" } },
        "excludes": { "type": "array", "items": { "$ref": "engineering/common.schema.json#/definitions/repoGlob" } },
        "dependsOn": { "type": "array", "uniqueItems": true, "items": { "$ref": "engineering/common.schema.json#/definitions/namespacedId" } },
        "identityAliases": { "type": "array", "uniqueItems": true, "items": { "$ref": "engineering/common.schema.json#/definitions/namespacedId" } },
        "controls": { "$ref": "#/definitions/controlMap" }
      }
    }
  }
}
