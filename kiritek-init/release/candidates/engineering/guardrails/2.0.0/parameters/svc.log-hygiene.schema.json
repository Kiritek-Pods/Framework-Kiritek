{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "title": "Parámetros de svc.log-hygiene",
  "type": "object",
  "additionalProperties": false,
  "properties": {
    "logsContract": {
      "type": "string",
      "minLength": 1,
      "pattern": "^(?![/~])(?![A-Za-z]:)(?!(?:.*/)?\\.\\.(?:/|$))[^\\u0000\\\\]+$"
    },
    "maxEvidenceAgeHours": {
      "type": "integer",
      "minimum": 1,
      "maximum": 720
    }
  }
}
