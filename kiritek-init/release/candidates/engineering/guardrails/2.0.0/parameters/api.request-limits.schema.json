{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "title": "Parámetros de api.request-limits",
  "type": "object",
  "additionalProperties": false,
  "properties": {
    "limitsContract": {
      "type": "string",
      "minLength": 1,
      "pattern": "^(?![/~])(?![A-Za-z]:)(?!(?:.*/)?\\.\\.(?:/|$))[^\\u0000\\\\]+$"
    },
    "maxBodyBytesLimit": {
      "type": "integer",
      "minimum": 256,
      "maximum": 10485760
    },
    "maxTimeoutMsLimit": {
      "type": "integer",
      "minimum": 10,
      "maximum": 120000
    },
    "maxEvidenceAgeHours": {
      "type": "integer",
      "minimum": 1,
      "maximum": 720
    }
  }
}
