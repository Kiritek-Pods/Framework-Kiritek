{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "title": "Parámetros de flags.lifecycle",
  "type": "object",
  "additionalProperties": false,
  "properties": {
    "flagRegistry": {
      "type": "string",
      "minLength": 1,
      "pattern": "^(?![/~])(?![A-Za-z]:)(?!(?:.*/)?\\.\\.(?:/|$))[^\\u0000\\\\]+$"
    },
    "maxLifetimeDays": {
      "type": "integer",
      "minimum": 1,
      "maximum": 730
    },
    "expiryWarningDays": {
      "type": "integer",
      "minimum": 0,
      "maximum": 90
    },
    "maxClientTimeoutMs": {
      "type": "integer",
      "minimum": 50,
      "maximum": 30000
    },
    "maxEvidenceAgeHours": {
      "type": "integer",
      "minimum": 1,
      "maximum": 720
    }
  }
}
