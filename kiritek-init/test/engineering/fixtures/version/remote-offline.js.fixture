"use strict";
// Harness propio de un equipo (trace-command) cuyo backend de política no
// responde durante el análisis local: declara la indisponibilidad.
const fs = require("fs");
fs.mkdirSync("out", { recursive: true });
fs.writeFileSync("out/version-trace.json", JSON.stringify({ schemaVersion: 1, harness: { name: "team-harness", version: "1.0.0" }, fatal: "REMOTE_UNAVAILABLE", scenarios: [] }));
