{
  "$schema": "../../../../schemas/config.schema.json",
  "version": 1,
  "mode": "warning",
  "defaultBranch": {
    "explicit": null,
    "remote": "origin"
  },
  "secrets": {
    "gitleaksVersion": "8.18.4",
    "historyDepth": "full"
  },
  "git": {
    "blockDirectDefaultPush": true,
    "forcePolicy": "deny"
  },
  "commits": {
    "enabled": true,
    "types": ["feat", "fix", "docs", "style", "refactor", "perf", "test", "build", "ci", "chore", "revert"],
    "requireScope": false,
    "maxSubjectLength": 72,
    "maxBodyLineLength": 100,
    "allowMergeCommits": true,
    "allowRevertCommits": true
  },
  "jira": {
    "enabled": false,
    "keyPattern": "[A-Z][A-Z0-9]+-[0-9]+",
    "unavailable": "fail-closed",
    "locations": ["commit", "branch", "pr"],
    "noJira": {
      "token": "NO-JIRA",
      "allowedTypes": ["chore", "docs", "ci"],
      "requireReason": true
    }
  },
  "evidence": {
    "maxAgeHours": 24,
    "directory": ".kiritek/security"
  },
  "telemetry": {
    "enabled": false
  }
}
