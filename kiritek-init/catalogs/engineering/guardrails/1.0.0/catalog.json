      "id": "search.input-rate",
      "version": "1.0.0",
      "contractVersion": "1.0.0",
      "profiles": {
        "allOf": [
          "search"
        ]
      },
      "moments": [
        {
          "moment": "agent",
          "scope": "change",
          "network": false,
          "budgetMs": 1500,
          "fallback": "defer-to-later-surface"
        },
        {
          "moment": "pre-commit",
