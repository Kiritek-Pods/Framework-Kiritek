        },
        {
          "moment": "pr",
          "scope": "change",
          "network": false,
          "budgetMs": 600000,
          "fallback": "error-operational"
        },
        {
          "moment": "release",
          "scope": "artifact",
          "network": false,
          "budgetMs": 900000,
          "fallback": "error-operational"
        }
      ],
      "parametersSchemaRef": "parameters/search.input-rate.schema.json",
      "supportedLevels": [
        "off",
        "warn"
      ],
      "defaults": {
        "level": "warn",
        "parameters": {
          "minChars": 3,
          "cadence": {
            "strategy": "equivalent",
            "windowMs": 250
          },
          "dedupeWindowMs": 500,
          "maxEvidenceAgeHours": 24
        }
      },
      "collectors": [
        "search-input-rate/collector"
      ],
      "normalizer": "search-input-rate/normalizer",
      "applicability": "search-input-rate/applicability",
      "evaluator": "search-input-rate/evaluator",
      "costClass": "medium",
      "timeoutMs": 120000,
      "cachePolicy": {
        "enabled": true,
        "ttlSeconds": 86400
      },
      "freshness": {
        "maxAgeSeconds": 86400
      },
      "permissions": {
        "filesystemRead": [],
        "networkHosts": [],
        "envNames": [],
        "processes": []
      },
      "documentationRef": "docs/engineering/controls/search-input-rate.md"
    },
