# Kiritek Framework — .graphifyignore base
# Se mergea con .gitignore; estas reglas tienen prioridad.
# Objetivo: que Graphify indexe código y docs propios del proyecto,
# nunca frameworks/librerías de terceros ni artefactos generados.

# Dependencias / paquetes de terceros
node_modules/
vendor/
venv/
.venv/
target/
build/
dist/
.dart_tool/
Pods/

# Artefactos generados
*.generated.py
*.freezed.dart
*.g.dart
*.g.dart.map
*.min.js

# Legacy / third-party framework code (regla explícita MYSCIE:
# la IA nunca debe indexar ni tocar frameworks de terceros embebidos)
# Agregar aquí manualmente las rutas de framework vendored del proyecto, ej:
# lib/sencha/
# lib/vendor-legacy/

# Secretos / config sensible (nunca indexar aunque no estén en .gitignore)
.env
.env.*
*.pem
*.key
secrets/
