{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "title": "Parámetros de analytics.events",
  "type": "object",
  "additionalProperties": false,
  "properties": {
    "trackingPlan": {
      "type": "string",
      "minLength": 1,
      "pattern": "^(?![/~])(?![A-Za-z]:)(?!(?:.*/)?\\.\\.(?:/|$))[^\\u0000\\\\]+$"
    },
    "forbiddenProperties": {
      "type": "array",
      "maxItems": 50,
      "uniqueItems": true,
      "items": {
        "type": "string",
        "pattern": "^[a-z][a-z0-9_]*$"
      }
    },
    "maxEvidenceAgeHours": {
      "type": "integer",
      "minimum": 1,
      "maximum": 720
    }
  }
}
