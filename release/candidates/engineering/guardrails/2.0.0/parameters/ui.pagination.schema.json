{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "title": "Parámetros de ui.pagination",
  "type": "object",
  "additionalProperties": false,
  "properties": {
    "listsContract": {
      "type": "string",
      "minLength": 1,
      "pattern": "^(?![/~])(?![A-Za-z]:)(?!(?:.*/)?\\.\\.(?:/|$))[^\\u0000\\\\]+$"
    },
    "maxPageSize": {
      "type": "integer",
      "minimum": 1,
      "maximum": 500
    },
    "maxEvidenceAgeHours": {
      "type": "integer",
      "minimum": 1,
      "maximum": 720
    }
  }
}
