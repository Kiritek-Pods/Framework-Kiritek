{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "title": "Parámetros de svc.health-shutdown",
  "type": "object",
  "additionalProperties": false,
  "properties": {
    "healthContract": {
      "type": "string",
      "minLength": 1,
      "pattern": "^(?![/~])(?![A-Za-z]:)(?!(?:.*/)?\\.\\.(?:/|$))[^\\u0000\\\\]+$"
    },
    "maxGraceMs": {
      "type": "integer",
      "minimum": 100,
      "maximum": 600000
    },
    "maxEvidenceAgeHours": {
      "type": "integer",
      "minimum": 1,
      "maximum": 720
    }
  }
}
