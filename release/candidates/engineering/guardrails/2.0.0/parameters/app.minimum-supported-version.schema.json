{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "title": "Parámetros de app.minimum-supported-version",
  "type": "object",
  "additionalProperties": false,
  "properties": {
    "policyContract": { "type": "string", "minLength": 1, "pattern": "^(?![/~])(?![A-Za-z]:)(?!(?:.*/)?\\.\\.(?:/|$))[^\\u0000\\\\]+$" },
    "versionScheme": { "type": "string", "enum": ["semver"] },
    "environments": { "type": "array", "minItems": 1, "uniqueItems": true, "items": { "type": "string", "pattern": "^[a-z][a-z0-9-]*$" } },
    "cache": {
      "type": "object",
      "additionalProperties": false,
      "required": ["ttlSeconds", "staleIfOfflineSeconds"],
      "properties": {
        "ttlSeconds": { "type": "integer", "minimum": 0, "maximum": 2592000 },
        "staleIfOfflineSeconds": { "type": "integer", "minimum": 0, "maximum": 2592000 }
      }
    },
    "firstRunOffline": { "type": "string", "enum": ["allow-with-warning", "block-with-explanation"] },
    "timeoutMs": { "type": "integer", "minimum": 100, "maximum": 30000 },
    "maxEvidenceAgeHours": { "type": "integer", "minimum": 1, "maximum": 720 }
  }
}
